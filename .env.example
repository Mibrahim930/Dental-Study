# Copy this file to .env.local and fill in the values.

# Passcode anyone must type before they can create an account or sign in
APP_PASSCODE=

# Long random string used to sign logins and encrypt users' API keys.
# Generate one with:  openssl rand -base64 32
# Never change it after users have signed up (their saved keys would stop working).
SECRET_KEY=

# Optional: where the database, PDFs and slide images are stored (default: ./data)
# DATA_DIR=./data

# Optional model overrides (defaults: claude-sonnet-5-5 and gpt-6.1-sol)
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6.1-sol

# Only used by scripts/test-slide.mts (users bring their own keys in the app)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
