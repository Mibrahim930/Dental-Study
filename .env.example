# Copy this file to .env.local and fill in the values.

# Your Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Passcode the student types to get into the site
APP_PASSCODE=

# Optional: Claude model used for everything (default: claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Optional: where the database, PDFs and slide images are stored (default: ./data)
# DATA_DIR=./data
