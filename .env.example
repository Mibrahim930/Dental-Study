# Copy this file to .env.local and fill in the values. Every variable the app reads is listed here.

# Passcode anyone must type before they can create an account or sign in
APP_PASSCODE=

# Long random string used to sign logins and encrypt users' API keys.
# Generate one with:  openssl rand -base64 32
# Never change it after users have signed up (their saved keys would stop working).
SECRET_KEY=

# Optional: where the database, PDFs and slide images are stored (default: ./data). On Railway, point it at the volume.
# DATA_DIR=./data

# Optional model overrides for the everyday work: slide reading, lessons, checking (defaults: claude-sonnet-5-5 and gpt-6.1-sol)
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6.1-sol

# Optional model overrides for writing quiz and exam questions (defaults: claude-opus-5-5, and OPENAI_MODEL for ChatGPT keys)
# CLAUDE_QUALITY_MODEL=claude-opus-5-5
# OPENAI_QUALITY_MODEL=gpt-6.1-sol

# Optional: set to 0 to skip the second AI pass that checks each new section-quiz question (default: on)
# QUIZ_JUDGE=1

# Optional daily backups to an S3-compatible bucket (setting endpoint, bucket and access key id turns them on)
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Only used by scripts/test-slide.mts (users bring their own keys in the app)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# NODE_ENV and NEXT_RUNTIME are set by Next.js itself; don't set them here.
